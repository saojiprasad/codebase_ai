# Backend
ACE_ENVIRONMENT=local
ACE_LOG_LEVEL=INFO
ACE_CORS_ORIGINS=["http://localhost:5173"]
ACE_DATA_DIR=data
ACE_PROJECT_DIR=data/projects
ACE_UPLOAD_DIR=data/uploads
ACE_VECTOR_DIR=data/vectors
ACE_SQLITE_PATH=data/codebase_explainer.db

# Embeddings
ACE_EMBEDDING_PROVIDER=sentence-transformers
ACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ACE_VECTOR_BACKEND=chroma

# Local LLM
ACE_LLM_PROVIDER=ollama
ACE_OLLAMA_BASE_URL=http://localhost:11434
ACE_OLLAMA_MODEL=qwen2.5-coder:7b
ACE_LLAMA_CPP_BASE_URL=http://localhost:8080
ACE_LLM_TEMPERATURE=0.15

# Frontend
VITE_API_BASE_URL=
